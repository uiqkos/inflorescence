# Inflorescence configuration — the complete reference.
#
# Every setting is an environment variable. Two dotenv files are read, in ascending
# precedence, and real environment variables outrank both:
#
#   1. ~/.config/inflorescence/.env   — written by `inflorescence init` (%APPDATA% on Windows)
#   2. ./.env                         — the working directory the process starts in
#
# Put the API key in the first. An MCP client launches the server from its own working
# directory, so a key that lives only in a project .env produces a server that starts clean
# and then fails every LLM call.
#
# Defaults are shown commented out, so an uncommented line is always an override. The README
# documents the dozen settings most people touch; this file is the full list, kept in sync
# with src/inflorescence/config.py.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenRouter API key — https://openrouter.ai/keys
# Needed for summaries and embeddings. Note that `doctor` only checks that a key is present,
# not that it has credit: an exhausted key still passes, then every call fails with 403 and
# you get an index with zero summaries and zero chunks.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Memgraph
# ---------------------------------------------------------------------------

# MEMGRAPH_URL=bolt://localhost:7687
# MEMGRAPH_USER=
# MEMGRAPH_PASSWORD=

# Vector indexes require the memgraph-mage image; on a plain Memgraph their creation fails.
# While true (the default), indexing aborts up front rather than charging you for embeddings
# that could never be searched. Set false for graph-only use on a search-less database.
# REQUIRE_SEARCH_INDEXES=true

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------

# LLM_MODEL=google/gemini-2.5-flash-lite
# LLM_BASE_URL=https://openrouter.ai/api/v1
# CODE_EMBEDDING_MODEL=openai/text-embedding-3-small
# SUMMARY_EMBEDDING_MODEL=openai/text-embedding-3-small

# Must match the output dimension of both embedding models. Changing it requires a re-index.
# EMBEDDING_DIMENSION=1536

# Skip LLM summarization entirely: builds the graph and code-chunk embeddings but no summaries.
# This is also the setting to use if you do not want source code sent to an LLM at all —
# see "What leaves your machine" in the README.
# USE_LLM_SUMMARIES=true

# Code-specialized embeddings (optional). Mistral's `codestral-embed` tops code-retrieval
# benchmarks but is NOT on OpenRouter, so point the code embedder at Mistral's own
# OpenAI-compatible endpoint. Its default output dimension is 1536 — matching the summary
# model — so no schema change is needed; just re-index after switching.
# CODE_EMBEDDING_MODEL=codestral-embed
# CODE_EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# CODE_EMBEDDING_API_KEY=your_mistral_key_here

# ---------------------------------------------------------------------------
# Cost guard
# ---------------------------------------------------------------------------

# A first-time index AND every background watcher update are gated by this cap. The default
# clears normal and even large repositories while stopping a runaway monorepo, or a
# thousand-file `git checkout` flush, cold. Set to an empty value to remove the cap.
# MAX_INDEX_COST_USD=10.0

# Per-million-token prices used for the estimate. Defaults match the default models above;
# update them if you switch, or the estimate — and therefore the cap — will be wrong.
# LLM_PRICE_INPUT_USD_PER_MTOK=0.25
# LLM_PRICE_OUTPUT_USD_PER_MTOK=1.50
# EMBEDDING_PRICE_USD_PER_MTOK=0.02

# ---------------------------------------------------------------------------
# Indexing
# ---------------------------------------------------------------------------

# Skip files larger than this many bytes.
# MAX_FILE_SIZE_BYTES=262144

# Honor .gitignore and .inflorescenceignore while scanning.
# RESPECT_GITIGNORE=true

# Skip recognisably generated files (protobuf output, *.min.js, bundles).
# SKIP_GENERATED=true

# Comma-separated globs. INCLUDE_PATTERNS empty means "every supported file".
# INCLUDE_PATTERNS=
# EXCLUDE_PATTERNS=

# Files parsed per batch.
# BATCH_SIZE=10

# Truncation applied to a single node's source before it is sent for summarization.
# SUMMARY_MAX_SOURCE_CHARS=12000

# ---------------------------------------------------------------------------
# SCIP semantic call resolution
# ---------------------------------------------------------------------------

# Use SCIP indexers (scip-go / scip-python / scip-typescript) for compiler-grade CALLS
# resolution where the project builds. A missing indexer, a failing build, or a timeout
# degrades that language to the syntactic ladder without failing the index.
#
# Be aware of what this does: the SCIP pass runs a real build toolchain inside the repository
# being indexed, which reads that repository's build configuration. Set false when indexing
# code you do not trust — or leave SCIP_RUNNER on its default, which confines that toolchain
# to a container with the repository mounted read-only.
# USE_SCIP_SEMANTIC=true

# Where the indexer comes from: `auto` prefers a binary on PATH and falls back to a container,
# `native` requires the binary, `docker` always containerizes. Nothing needs to be installed
# by hand in the default mode.
# SCIP_RUNNER=auto

# Per-language image overrides, as JSON. Defaults pair Go with its own image and Python +
# TypeScript with the shared Node image (both indexers are Node programs).
# SCIP_IMAGES={"go": "ghcr.io/uiqkos/inflorescence-scip-go:v1"}

# Per-root wall-clock budget for one SCIP indexer run.
# SCIP_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Chunking and batching
# ---------------------------------------------------------------------------

# CHUNK_SIZE=3000
# CHUNK_OVERLAP=1000

# Chunks/summaries embedded and stored per window, bounding peak memory.
# RAG_INDEX_BATCH_SIZE=256

# Rows per UNWIND write to Memgraph.
# DB_WRITE_BATCH_SIZE=500

# ---------------------------------------------------------------------------
# Watcher and logging
# ---------------------------------------------------------------------------

# Quiet period before a batch of file changes is flushed.
# WATCHER_DEBOUNCE_SECONDS=5.0

# CRITICAL, ERROR, WARNING, INFO or DEBUG. `--debug` on the command line overrides this.
# LOG_LEVEL=INFO
